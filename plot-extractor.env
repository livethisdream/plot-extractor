# plot-extractor settings
# Edit this file (pencil icon on GitHub, works from a phone) and commit.
# The next run picks it up. Values: true/false, or text.
# Environment variables and command-line flags override these.

# Re-plotted chart from the extracted data, one PNG per plot
PLOTX_REPLOT=true

# Original plot with the extracted points drawn on top, one PNG per plot
PLOTX_OVERLAY=true

# Optional local LLM that turns titles/labels into structured metadata.
# Leave empty to turn it off. Example: http://hermes.local:8080/v1
PLOTX_LLM_URL=
PLOTX_LLM_MODEL=local
